 "Vulnerability": [
  {
   "Title": {
    "Value": "Active Directory Federation Services Elevation of Privilege Vulnerability"
   },
   "Notes": [
    {
     "Title": "Description",
     "Type": 2,
     "Ordinal": "0",
     "Value": "<p>Insufficient granularity of access control in Active Directory Federation Services (AD FS) allows an authorized attacker to elevate privileges locally.</p>\n"
    },
    {
     "Title": "FAQ",
     "Type": 4,
     "Ordinal": "10",
     "Value": "<p><strong>What privileges could be gained by an attacker who successfully exploited the vulnerability?</strong></p>\n<p>An attacker who successfully exploited this vulnerability could gain administrator privileges.</p>\n"
    },
    {
     "Title": "Active Directory Federation Services (AD FS)",
     "Type": 7,
     "Ordinal": "20",
     "Value": "Active Directory Federation Services (AD FS)"
    },
